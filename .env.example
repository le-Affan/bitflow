# BitFlow settings. OPTIONAL: `docker compose up -d --build` works without any .env file.
# Copy this file to .env only to override defaults, then uncomment and change the lines you need.
# Every line below shows the default that docker-compose.yml uses when the variable is not set.
# A .env file may hold a real password: never commit it (it is gitignored).

# --- Database ---
# PostgreSQL, run by docker compose and NOT published on the host
# (to look inside: docker compose exec postgres psql -U bitflow -d bitflow).
# The defaults are for local use only: change POSTGRES_PASSWORD before any real deployment. It only takes effect
# when the database volume is created (first start); to change it later, change it inside Postgres too.
#POSTGRES_USER=bitflow
#POSTGRES_PASSWORD=bitflow
#POSTGRES_DB=bitflow
# Separate database used only by the backend test suite; created by the tests if missing and wiped by every test.
#POSTGRES_TEST_DB=bitflow_test

# --- Backend ---
# Host port the backend API is published on (bound to 127.0.0.1).
#BACKEND_HOST_PORT=8000
# Origins allowed to call the API from a browser, comma-separated. Empty = CORS disabled.
# Default: the frontend's and the e2e frontend's origins, built from FRONTEND_HOST_PORT and FRONTEND_E2E_HOST_PORT:
#CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3100

# --- Frontend ---
# Host port the frontend (nginx) is published on (bound to 127.0.0.1).
#FRONTEND_HOST_PORT=3000
# URL the browser uses to reach the backend API. Default: http://127.0.0.1:<BACKEND_HOST_PORT>.
# Baked into the static build: rebuild the frontend after changing it (docker compose up -d --build).
#VITE_API_BASE_URL=http://127.0.0.1:8000
# Host port of the separate e2e build of the frontend (with the test inspector); only used by Playwright.
#FRONTEND_E2E_HOST_PORT=3100

# --- Scheduler ---
# The scheduler container runs catch-up (every missing complete UTC day up to yesterday) once when it starts,
# then every day at this UTC time (HH:MM).
#DAILY_INGEST_TIME_UTC=00:30

# --- Bitcoin data source ---
# Empty = https://blockchain.info
#BLOCKCHAIN_INFO_BASE_URL=

# --- Ingestion tuning ---
# Empty values use the defaults shown.
# Pause between requests (default 1.0 s).
#INGEST_REQUEST_PAUSE_SECONDS=1.0
# Retries per request on timeouts, 429/430 and 5xx (default 5), exponential backoff from this base (default 2.0 s).
#INGEST_MAX_RETRIES=5
#INGEST_BACKOFF_BASE_SECONDS=2.0
# HTTP timeouts (defaults 10 s connect, 120 s read).
#INGEST_CONNECT_TIMEOUT_SECONDS=10
#INGEST_READ_TIMEOUT_SECONDS=120
# Extra blocks fetched beyond each end of the day's height range (default 3).
#INGEST_MARGIN_BLOCKS=3

# --- Playwright e2e tests only ---
# User and group the Playwright container runs as (so test output files belong to you).
#E2E_UID=1000
#E2E_GID=1000
# "1" = mock every API call as "no day ingested".
#E2E_MOCK_EMPTY_API=

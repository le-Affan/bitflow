# BitFlow environment variables.
# Copy to .env and fill in. Sections without variables are not decided yet.

# --- Backend ---
# Host port the backend is published on (bound to 127.0.0.1).
BACKEND_HOST_PORT=8000

# --- Database ---
# PostgreSQL, run by docker-compose. The backend's DATABASE_URL is built from these in docker-compose.yml.
POSTGRES_USER=bitflow
# Required. Choose a password; docker compose refuses to start without one.
POSTGRES_PASSWORD=
POSTGRES_DB=bitflow
# Separate database used only by the test suite. Created by the tests if missing; its contents are wiped by every test.
POSTGRES_TEST_DB=bitflow_test
# Host port postgres is published on (bound to 127.0.0.1).
POSTGRES_HOST_PORT=5432

# --- Bitcoin data source ---

# --- Ingestion ---

# --- Frontend ---

# BitFlow environment variables.
# Copy to .env and fill in. Sections without variables are not decided yet.

# --- Backend ---
# Host port the backend is published on (bound to 127.0.0.1).
BACKEND_HOST_PORT=8000
# Origins allowed to call the API from a browser, comma-separated. Empty = CORS disabled.
# Must contain the frontend's origin (see FRONTEND_HOST_PORT), or the browser blocks every API call.
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Database ---
# PostgreSQL, run by docker-compose. The backend's DATABASE_URL is built from these in docker-compose.yml.
POSTGRES_USER=bitflow
# Required. Choose a password; docker compose refuses to start without one.
POSTGRES_PASSWORD=
POSTGRES_DB=bitflow
# Separate database used only by the test suite. Created by the tests if missing; its contents are wiped by every test.
POSTGRES_TEST_DB=bitflow_test
# Host port postgres is published on (bound to 127.0.0.1).
POSTGRES_HOST_PORT=5432

# --- Bitcoin data source ---
# Empty = https://blockchain.info
BLOCKCHAIN_INFO_BASE_URL=

# --- Ingestion ---
# Empty values use the defaults shown.
# Pause between requests (default 1.0 s).
INGEST_REQUEST_PAUSE_SECONDS=
# Retries per request on timeouts, 429/430 and 5xx (default 5), exponential backoff from this base (default 2.0 s).
INGEST_MAX_RETRIES=
INGEST_BACKOFF_BASE_SECONDS=
# HTTP timeouts (defaults 10 s connect, 120 s read).
INGEST_CONNECT_TIMEOUT_SECONDS=
INGEST_READ_TIMEOUT_SECONDS=
# Extra blocks fetched beyond each end of the day's height range (default 3).
INGEST_MARGIN_BLOCKS=

# --- Frontend ---
# Host port the frontend (nginx) is published on (bound to 127.0.0.1).
FRONTEND_HOST_PORT=3000
# URL the browser uses to reach the backend API. Baked into the static build: rebuild the frontend after changing it.
VITE_API_BASE_URL=http://127.0.0.1:8000
